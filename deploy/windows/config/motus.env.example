# MOTUS configuration TEMPLATE. The real file (config\motus.env) is created by 2-Setup-Database.ps1 with generated
# secrets and locked to Administrators/SYSTEM/LOCAL SERVICE. Never put real values in this template or in a ZIP.
MOTUS_HOST=127.0.0.1
MOTUS_PORT=3000
PUBLIC_ORIGIN=https://motus.sabeelbus.com
MOTUS_TRUST_PROXY=1
MOTUS_TIMEZONE=Africa/Cairo
MOTUS_LOG_LEVEL=info
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=motus
MOTUS_DB_APP_USER=motus_app
MOTUS_DB_APP_PASSWORD=<generated>
MOTUS_DB_OWNER_USER=motus_owner
MOTUS_DB_OWNER_PASSWORD=<generated>
MOTUS_CREDENTIALS_KEY=<64 hex characters, generated>
MOTUS_SESSION_HOURS=12
MOTUS_SESSION_IDLE_MINUTES=120
